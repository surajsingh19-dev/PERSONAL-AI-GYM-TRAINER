# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides
# Google-maintained alias that always points at the current Flash model.
# If it ever 404s (Google occasionally retires aliases), swap in a pinned
# version name from https://ai.google.dev/gemini-api/docs/models, e.g. gemini-2.5-flash
GEMINI_MODEL=gemini-flash-latest

# Used automatically if the primary model returns a 503 (overloaded) after
# retrying. Flash-Lite is smaller/faster and usually has more spare capacity.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

PORT=3000
